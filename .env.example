# Discord Bot Token (REQUIRED)
# Get yours at: https://discord.com/developers/applications
BOT_TOKEN=your_token_here

# Discord Channel ID for error logging (REQUIRED)
# Right-click channel > Copy Channel ID (enable Developer Mode in Discord settings)
LOGGING_COG_CHANNEL_ID=your_channel_id_here

# Admin role name (optional, default: Admin)
TLE_ADMIN=Admin

# Moderator role name (optional, default: Moderator)  
TLE_MODERATOR=Moderator
